# Image tags pinned in spike S1 (2026-11-06). Verified to exist on Docker Hub; see docs/decisions.md.
# docker-compose.yml uses these same values as defaults, so a .env file is optional.
# Copy to .env (git-ignored) only to override something.
KAFKA_IMAGE=apache/kafka:4.4.0
SPARK_IMAGE=spark:4.2.1-scala2.13-java17-python3-ubuntu
SPARK_KAFKA_CONNECTOR=org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.1
POSTGRES_IMAGE=postgres:18.6
GRAFANA_IMAGE=grafana/grafana:13.3.0

# Local development credentials only. Not secrets: the stack is not exposed beyond localhost.
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=market
