          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(m AT TIME ZONE 'UTC', 'HH24:MI') AS minute, coalesce(a.n, 0) AS alerts FROM generate_series((SELECT max(window_start) FROM bars) - interval '59 minutes', (SELECT max(window_start) FROM bars), interval '1 minute') AS m LEFT JOIN (SELECT window_start, count(*) AS n FROM alerts GROUP BY 1) a ON a.window_start = m ORDER BY m"
        }
      ],
      "options": {
        "orientation": "vertical",
        "xField": "minute",
        "showValue": "never",
        "barWidth": 0.9,
